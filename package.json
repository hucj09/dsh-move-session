{
  "name": "@hucj/dsh-move-session",
  "description": "Cross-workspace session migration for the dsh web GUI: a Move Session header action plus dialog (target workspace picker, keep-or-archive the original), idle-session only, full context preserved. Hot-pluggable — mounted via ~/.dsh/cordis.patch.yml + a profile node_modules symlink, no dsh source changes.",
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [],
      "platform": "web"
    }
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "README.en.md",
    "LICENSE"
  ],
  "scripts": {
    "check": "node --check lib/index.js && node --check lib/client.js && npm test",
    "test": "node --test",
    "test:ui": "python scripts/test_dialog_fixed.py && python scripts/test_menu_injection.py",
    "test:integrity": "python scripts/verify_integrity.py && python scripts/verify_chunks.py"
  },
  "engines": {
    "node": ">=22"
  },
  "license": "BSD-3-Clause",
  "author": "hucj",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hucj09/dsh-move-session.git"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "plugin",
    "move-session",
    "session-migration",
    "workspace"
  ]
}
